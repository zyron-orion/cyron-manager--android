<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window background is dark because the app opens in its dark Compose theme by default.
        System bar icon colours are switched at runtime from the saved app theme (see CyronApp).
    -->
    <style name="Theme.Cyron" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cyron_launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
